# Placeholder only: replace with a cryptographically random, private value.
# Compose inserts a 32-byte hex value directly into the PostgreSQL URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_CHARACTER_HEX_SECRET

# Placeholder only: replace with a different cryptographically random secret.
GARMIN_MCP_HTTP_BEARER_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_64_CHARACTER_HEX_SECRET

# Required IANA time zone, for example America/Denver.
GARMIN_MCP_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE

# Optional: Compose defaults to 06:00,18:00 if this variable is omitted.
# Values are local times in GARMIN_MCP_TIMEZONE. Edit this value to change
# the worker schedule; no image rebuild is required.
GARMIN_MCP_SYNC_TIMES=06:00,18:00
